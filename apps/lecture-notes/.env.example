# Free by default. Leave these as they are for local Whisper + Ollama.
TRANSCRIBE_PROVIDER=local
NOTES_PROVIDER=ollama

# whisper.cpp. ./start.sh downloads this file if it is missing.
WHISPER_BIN=whisper-cli
WHISPER_MODEL=./models/ggml-base.en.bin

# Ollama. ./start.sh pulls llama3.2 if it is missing.
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=llama3.2

# Optional paid route. Set both providers to openai and add a key.
# Do not commit the real key.
# TRANSCRIBE_PROVIDER=openai
# NOTES_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_TRANSCRIBE_MODEL=whisper-1
# OPENAI_NOTES_MODEL=gpt-4o-mini
