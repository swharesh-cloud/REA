# AI Gateway credential for local `npm run dev`.
# Create a key in the Vercel dashboard: Team → AI Gateway → API Keys.
# Do not commit the real value. On Vercel, OIDC can replace this key.
AI_GATEWAY_API_KEY=

# Optional. Defaults are current AI Gateway model IDs.
# Catalog: https://ai-gateway.vercel.sh/v1/models
LECTURE_TRANSCRIBE_MODEL=openai/whisper-1
LECTURE_NOTES_MODEL=google/gemini-3-flash
